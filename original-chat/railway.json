{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "nixpacksPlan": {
      "phases": {
        "install": {
          "dependsOn": ["setup"],
          "cmds": ["cd frontend && npm install --legacy-peer-deps"]
        },
        "build": {
          "dependsOn": ["install"],
          "cmds": ["cd frontend && npm run build"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "cd frontend && npm start --omit=dev"
  }
}
